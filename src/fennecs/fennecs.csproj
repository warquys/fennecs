<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <PackageId>fennecs</PackageId>
        <Title>fennecs - tiny ECS</Title>
        <OutputType>Library</OutputType>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    </PropertyGroup>

    <!-- Version is derived from git tags (v-prefixed, e.g. v0.7.1-pre) via MinVer at build time. -->
    <PropertyGroup>
        <MinVerTagPrefix>v</MinVerTagPrefix>

        <!--
            MinVer's target is skipped in a design time build, which is the path Hot Reload compiles
            through. A normal Debug build stamped AssemblyVersion from the git tags while that path
            fell back to the SDK default, and Edit and Continue refuses a reference whose version
            moved (CS7038). Debug is not what gets packaged, so it simply keeps the default.
        -->
        <MinVerSkip Condition="'$(Configuration)' == 'Debug'">true</MinVerSkip>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="MinVer" Version="7.0.0" PrivateAssets="all" />
    </ItemGroup>

    <PropertyGroup>
        <Product>fennecs Entity-Component System</Product>
        <Authors>Moritz Voss</Authors>
        <Company>tiger.blue</Company>
        <Description>The tiny ECS that could!</Description>
        <Copyright>2026 Moritz Voss</Copyright>

        <RepositoryUrl>https://github.com/outfox/fennecs</RepositoryUrl>
        <RepositoryType>Github</RepositoryType>

        <PackageProjectUrl>https://fennecs.net</PackageProjectUrl>
        <PackageReadmeFile>nuget.md</PackageReadmeFile>
        <PackageReleaseNotes>https://github.com/outfox/fennecs/releases</PackageReleaseNotes>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageTags>ecs, entity, component, system, game, gamedev, game-development, godot, monogame, flax, stride, entity-component, entity-component-system</PackageTags>
        <PackageIcon>fennecs-icon-nuget.png</PackageIcon>
    </PropertyGroup>

    <ItemGroup>
        <SupportedPlatform Include="browser" />
    </ItemGroup>
    
    <PropertyGroup>
        <AssemblyName>fennecs</AssemblyName>
        <TargetFramework>net10.0</TargetFramework>

        <IsTrimmable>true</IsTrimmable>
        <VerifyReferenceTrimCompatibility>true</VerifyReferenceTrimCompatibility>

        <Configurations>Release;Debug</Configurations>
        <Platforms>AnyCPU</Platforms>

        <DebugType>portable</DebugType>
        <DebugSymbols>true</DebugSymbols>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>

        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
        <Optimize>true</Optimize>
        <EnablePackageValidation>true</EnablePackageValidation>
    </PropertyGroup>

    <ItemGroup>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
            <_Parameter1>$(AssemblyName).tests</_Parameter1>
        </AssemblyAttribute>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
            <_Parameter1>$(AssemblyName).benchmarks</_Parameter1>
        </AssemblyAttribute>
    </ItemGroup>

    <ItemGroup>
        <None Include="../nuget/nuget.md" Pack="true" PackagePath="\"/>
        <None Include="../nuget/fennecs-icon-nuget.png">
            <PackagePath>.</PackagePath>
            <Pack>True</Pack>
            <Link>fennecs-icon-nuget.png</Link>
        </None>
        <None Include="generators\Stream.generated.cs">
            <DesignTime>True</DesignTime>
            <AutoGen>True</AutoGen>
            <DependentUpon>Stream.tt</DependentUpon>
        </None>
        <None Update="generators\Delegates.tt">
          <Generator>TextTemplatingFileGenerator</Generator>
          <LastGenOutput>Delegates.generated.cs</LastGenOutput>
        </None>
    </ItemGroup>

    <ItemGroup>
        <None Update="generators\Stream.tt">
            <Generator>TextTemplatingFileGenerator</Generator>
            <LastGenOutput>Stream.generated.cs</LastGenOutput>
        </None>
    </ItemGroup>

    <ItemGroup>
        <None Update="generators\FilteredStream.tt">
            <Generator>TextTemplatingFileGenerator</Generator>
            <LastGenOutput>FilteredStream.generated.cs</LastGenOutput>
        </None>
    </ItemGroup>

    <ItemGroup>
        <Compile Update="generators\FilteredStream.generated.cs">
            <AutoGen>True</AutoGen>
            <DesignTime>True</DesignTime>
            <DependentUpon>FilteredStream.tt</DependentUpon>
        </Compile>
    </ItemGroup>

    <ItemGroup>
        <None Update="generators\EntityTemplate.tt">
            <Generator>TextTemplatingFileGenerator</Generator>
            <LastGenOutput>EntityTemplate.generated.cs</LastGenOutput>
        </None>
    </ItemGroup>

    <ItemGroup>
      <Compile Update="generators\EntityTemplate.generated.cs">
        <AutoGen>True</AutoGen>
        <DesignTime>True</DesignTime>
        <DependentUpon>EntityTemplate.tt</DependentUpon>
      </Compile>
    </ItemGroup>

    <ItemGroup>
      <Compile Update="generators\Delegates.generated.cs">
        <AutoGen>True</AutoGen>
        <DesignTime>True</DesignTime>
        <DependentUpon>Delegates.tt</DependentUpon>
      </Compile>
    </ItemGroup>
</Project>
